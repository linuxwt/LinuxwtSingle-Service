# ============================================================
# LiteLLM + CCR 部署环境变量模板
# 复制为 .env 后填写真实值：cp .env.example .env
# 注意：.env 含真实密钥，永远不要提交到 git
# ============================================================

# 上游网关的访问凭证（你的 vLLM 网关 / LLM 网关签发的 token）
GW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LiteLLM 对外暴露的 master key，调用方（CCR、你的应用）使用这个
# 部署时随机生成：openssl rand -hex 32
LITELLM_MASTER_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LITELLM_LOG=INFO
TZ=Asia/Shanghai
